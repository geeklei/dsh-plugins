    "csv-parse": "^5.6.0"
  },
  "scripts": {
    "test": "node test-plugin.js",
    "prepublishOnly": "npm test"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "private": false,
  "publishConfig": {
    "registry": "https://registry.npmjs.org/",
