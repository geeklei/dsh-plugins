{
  "name": "dsh-http-client",
  "version": "0.1.1",
  "description": "Guarded HTTP client for DeepSeek Harness: domain allowlist, timeout, response size cap and truncation. Only whitelisted hosts are reachable.",
  "type": "module",
  "main": "index.js",
  "files": [
    "index.js",
    "cordis.patch.yml",
    "README.md"
  ],
  "keywords": [
    "dsh",
    "plugin",
    "http",
    "api"
  ],
  "license": "MIT",
  "dependencies": {
    "@deepseek-ai/dsh-tools": "0.1.1-rc.2"
  },
  "scripts": {
    "test": "node test-plugin.js",
    "prepublishOnly": "npm test"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "private": false,
  "publishConfig": {
    "registry": "https://registry.npmjs.org/",
    "access": "public",
    "tag": "latest"
  }
}
